# MiniMax API Configuration
MINIMAX_API_KEY=your_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Server
PORT=3001

# Data directory (use /data on Fly.io for persistent volume)
DATA_DIR=./

# CORS whitelist (set to your frontend domain in production)
CORS_ORIGIN=http://localhost:5173

# Generation task database
GENERATION_TASK_DB_PATH=./generation-tasks.db